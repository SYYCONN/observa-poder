# Para rodar o backend fora do Docker. O banco precisa estar acessível localmente.
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=politica
DB_USER=politica
DB_PASSWORD=change-me-locally
# Em produção: HTTPS, senha longa e hosts explícitos (JSON, sem porta).
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=["localhost","127.0.0.1","test","testserver"]
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
RATE_LIMIT_MAX_CLIENTS=10000
EXPORT_LIMIT_PER_MINUTE=6
EXPORT_LIMIT_BURST=2
DB_STATEMENT_TIMEOUT_MS=15000

# Analytics opcional; token somente no backend, nunca NEXT_PUBLIC.
ANALYTICS_ENABLED=false
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_RETENTION_DAYS=90

# Explicações autônomas; nunca exponha OPENAI_API_KEY no frontend.
CONTENT_ADMIN_TOKEN=
CITIZEN_EXPLANATION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_CITIZEN_GENERATION_MODEL=
OPENAI_CITIZEN_VERIFICATION_MODEL=
CITIZEN_EXPLANATION_INTERVAL_MINUTES=30
CITIZEN_EXPLANATION_BATCH_SIZE=10
