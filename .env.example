# Somente desenvolvimento local. Copie para .env e substitua a senha.
POSTGRES_DB=politica
POSTGRES_USER=politica
POSTGRES_PASSWORD=change-me-locally

# Portas locais; altere se outros projetos já as utilizarem.
FRONTEND_PORT=3000
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_STARTUP=true
DEPUTIES_IMPORT_INTERVAL_MINUTES=1440
DEPUTY_PROFILES_IMPORT_ENABLED=true
DEPUTY_PROFILES_IMPORT_INTERVAL_MINUTES=43200
SENATORS_IMPORT_INTERVAL_MINUTES=1440
SENATE_LEGISLATION_IMPORT_INTERVAL_MINUTES=360
LEGISLATION_IMPORT_INTERVAL_MINUTES=60
CAMARA_EXPENSES_IMPORT_ENABLED=true
CAMARA_EXPENSES_IMPORT_INTERVAL_MINUTES=1440
# Ano de referência da carga; altere para repetir uma carga histórica.
CAMARA_EXPENSES_YEAR=2026
CAMARA_REMUNERATION_IMPORT_ENABLED=true
# A folha mensal é atualizada uma vez por mês e preserva a competência consultada.
CAMARA_REMUNERATION_IMPORT_INTERVAL_MINUTES=43200
CAMARA_STAFF_IMPORT_ENABLED=true
CAMARA_STAFF_IMPORT_INTERVAL_MINUTES=43200
# A carga usa o arquivo aberto oficial do Portal; não requer chave de API.
PORTAL_TRANSPARENCIA_API_TOKEN=
PORTAL_AMENDMENTS_IMPORT_ENABLED=true
PORTAL_AMENDMENTS_IMPORT_INTERVAL_MINUTES=1440
PORTAL_AMENDMENTS_YEAR=2026
PORTAL_AMENDMENTS_REQUEST_INTERVAL_SECONDS=0.25
CAMARA_VOTES_IMPORT_ENABLED=true
CAMARA_VOTES_IMPORT_INTERVAL_MINUTES=10080
CAMARA_VOTES_YEAR=2026
ELECTION_RESULTS_IMPORT_ENABLED=false
ELECTION_RESULTS_YEAR=2022
ELECTION_RESULTS_IMPORT_INTERVAL_MINUTES=525600
BACKEND_PORT=8000

# Analytics opcional; token somente no backend, nunca NEXT_PUBLIC.
ANALYTICS_ENABLED=false
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_RETENTION_DAYS=90
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Acesso somente ao monitor técnico; use um valor longo e diferente do token de Analytics.
CONTENT_ADMIN_TOKEN=

# Explicações cidadãs autônomas. A chave e os modelos ficam somente no backend.
CITIZEN_EXPLANATION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_CITIZEN_GENERATION_MODEL=
OPENAI_CITIZEN_VERIFICATION_MODEL=
CITIZEN_EXPLANATION_INTERVAL_MINUTES=30
CITIZEN_EXPLANATION_BATCH_SIZE=10
