# Copy outside the repository and replace values. Contains references only.
OBSERVA_HOST=observa.example
OBSERVA_PRIVACY_CONTACT=privacidade@observa.example
OBSERVA_API_IMAGE=observa-api:reviewed
OBSERVA_WEB_IMAGE=observa-web:reviewed
OBSERVA_POSTGRES_IMAGE=postgres:17-alpine
OBSERVA_SECRET_DIR=/etc/observa-poder/secrets
# Docker host/gateway address actually seen by the API. Replace after verifying.
OBSERVA_PROXY_PEER=192.0.2.1
OBSERVA_API_PORT=18080
OBSERVA_WEB_PORT=13000
